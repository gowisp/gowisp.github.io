lename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"campaign_id":"701cx00000g2LOl","footer_info":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null}}]},"success_message":"Thank you for getting in touch! We'll come back to you soon.","notification_style":"default","submit_button_text":"SUBMIT","default_error_message":"Something went wrong. Please try again."},"slug":"contact-us","full_slug":"global/forms/contact-us","sort_by_date":null,"position":90,"tag_list":[],"is_startpage":false,"parent_id":117675529470358,"meta_data":null,"group_id":"d567ee30-9fb1-4c00-87be-d6d1b01e15b6","first_published_at":"2025-11-29T12:57:31.050Z","release_id":null,"lang":"default","path":null,"alternates":[],"default_full_slug":null,"translated_slugs":null,"_stopResolving":true}],"component":"FormReference"},{"_uid":"9d940805-a488-4487-92a4-4553c418df11","tabs":[{"_uid":"7d66aa0f-d6f8-435d-ace1-7f7eccccdb6a","items":[{"_uid":"fa5300bd-0122-4ae1-b05b-63bcc73ca68f","title":"What does Terminal actually do?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is an AI-native Yard Operating System","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]},{"text":"TM","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}},{"type":"superscript"}]},{"text":" (YOS","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]},{"text":"TM","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}},{"type":"superscript"}]},{"text":") that uses computer vision to automate yard execution from gate to dock. It replaces manual logs with a system that proactively decides and executes the next best move in real-time.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"7a59feaa-09bb-43c1-ae93-457774136f53","title":"How is this different from a traditional Yard Management System (YMS)?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Traditional YMS are \"digital clipboards\" that record what already happened; Terminal is an ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]},{"text":"operating","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}},{"type":"italic"}]},{"text":" system that sees what is happening now and orchestrates what needs to happen next in the yard. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"d768b9c1-a55c-4ec1-b3bb-bccc883702fe","title":"What is \"Agentic AI\" in the context of the yard?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"It acts as a 24/7 autonomous supervisor that handles exceptions and reprioritizes tasks based on real-time conditions, ensuring the most critical moves happen first (e.g. how to prepare and reallocate resources for a late appointment)","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"8c3a680e-0de1-4c15-bdba-5f54421dced0","title":"How accurate is the data captured by your system?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Our proprietary computer vision stack delivers 50% or more improvement in data accuracy vs. manual operations, virtually eliminating the human error and \"lost assets\" common with manual entry.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"025d6ee4-cbc7-4be7-87ee-bd12107573f3","title":"Can we manage multiple sites from a single login?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yes; Terminal provides a \"Global Control Tower\" view, allowing you to compare KPIs, dwell times, and performance across all facilities in your network in one place.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Core Technology","component":"TabbedAccordionTab"},{"_uid":"dceb27e0-6179-4381-a4c7-17a0d4651ebe","items":[{"_uid":"89f88d31-a35a-4aa7-8dca-19c26c47ff88","title":"How is Terminal priced?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is priced as a competitive annual, all-inclusive as-a-service model for all hardware, support, and services. Deployments can vary and are charged as a separate up-front fee.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"9e286feb-6db3-4f51-8291-512a571f1779","title":"What kind of ROI can I expect?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Most customers see a 4x+ ROI within the first year and achieve a full payback in less than 5 months through labor savings and faster throughput.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"5a7c581e-5744-4fcb-b29c-a1d012b8cc15","title":"How does Terminal reduce carrier and facility costs?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"We reduce labor costs by automating routine yard tasks, reduce driver detention fees by improving gate processing times, faster responsiveness at the dock, and maximum visibility to all asset inventory in the yard. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"2e58f1a1-3443-42ac-b90c-0507e9c5515e","title":"Can Terminal help with regulatory compliance?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yes; our Indirect Source Rule (ISR) feature automates compliance by generating audit-ready data for regulations like Rule 2305.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"f6e2a6d8-062a-414d-bff5-90ea45e0b4ad","title":"Who is Terminal best suited for?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Highly modular, Terminal is built for both mid-market and enterprise 3PLs, retailers, and manufacturers managing complex, medium- to high-volume multi-yard networks that want to scale without adding headcount.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"7b4340cd-a099-4a03-bdf3-bf0535e4bca9","title":"Is Terminal a stable long-term partner? ","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Founded in 2023 and backed by 8VC and four of the top 10 U.S. logistics firms (including Prologis and Ryder), Terminal offers deep financial and strategic stability.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Value","component":"TabbedAccordionTab"},{"_uid":"b6b45d33-0378-4b49-ae6b-652e702734d3","items":[{"_uid":"b27dfbd9-0b1e-4395-99c6-e2fad45bbf34","title":"How fast can we go live?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Gate automation can be live in as little as 5 days, with full yard orchestration typically completed in 45 days.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"6220d91b-0e20-4a7c-b208-10f841ff7673","title":"Does Terminal integrate with my existing WMS/TMS?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yes; we offer seamless, event-driven integration with major platforms like Manhattan, SAP, Blue Yonder, FourKites, and project44.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"b3672b11-859f-45f8-a1aa-35418859fbe8","title":"Do I need to buy expensive proprietary cameras?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"No; Terminal is hardware-agnostic and can often leverage your existing IP cameras, or you can use our plug-and-play \"Terminal in a Camera\" bundles.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"448ad380-c09c-4821-8c57-dc3025344522","title":"Is the platform modular or \"all-or-nothing\"?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The system is highly configurable; you can start with a single use case, like Gate Acceleration, and expand into full yard orchestration over time.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"eec49cc9-7d64-468f-98bb-310a3530e057","title":"What happens if our site’s internet goes down?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is designed with local resilience; mission-critical tasks continue to buffer locally and sync to the cloud once connectivity is restored.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"7a1a3025-9fb6-48a8-8bca-2dcadb80b01a","title":"How does Terminal protect my data?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"We use a zero-trust security model with industry-standard encryption and are currently in the process of achieving SOC-2 compliance.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Implementation","component":"TabbedAccordionTab"},{"_uid":"48064379-150b-4b61-aadc-6987e47d7e5b","items":[{"_uid":"b6a2868c-e819-4f9a-8911-e503e5faf38f","title":"How do drivers and yard spotters interact with the system?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is browser-based (no app to download). Drivers can use their personal mobile devices, while spotters and dock workers can be outfitted with any browser-enabled mobile device approved by the operator. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"0f2e45fa-bc19-4989-b435-7444a08784a1","title":"How does this change the role of my yard office staff?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Staff shift from manual data entry to \"exception management,\" only intervening when the AI flags a specific issue that requires human judgment.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"7f0369fe-bedb-47d8-8666-e3b40cdd3ade","title":"Will implementation disrupt my current operations?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"No; our deployment model requires little operational downtime and carries a very low IT lift for your team.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"0aa420a1-b704-4369-a536-a341f4d20d73","title":"What kind of support and training do you provide?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"We provide \"White-Glove\" on-site training for all shifts, 24/7 live technical support, and a dedicated hypercare period post-launch.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}