{"story":{"name":"Terminal AI Computer Vision","created_at":"2025-11-29T11:24:18.760Z","published_at":"2025-12-22T19:56:03.444Z","updated_at":"2026-06-25T20:42:49.097Z","id":117661117776734,"uuid":"2c22085b-19ca-40a4-a949-1fa78468b627","content":{"_uid":"f9c66e72-a90b-4960-9519-70766d4676ea","body":[{"css":"","_uid":"609867cb-bb89-46b7-9f6a-80b80789b29e","copy":{"type":"doc","content":[{"type":"paragraph"}]},"wide":false,"label":" Terminal AI Computer Vision","title":{"type":"doc","content":[{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"A New Vision for Yard Execution","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}},{"type":"bold"}]}]}]},"buttons":[],"component":"SectionIntroduction","top_notch":false,"bottom_notch":false,"isFullscreen":true,"content_blocks":[],"subscribe_form":false,"background_type":"canvas_grid_waves","multipleColumns":false,"background_image":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"background_theme":"","buttons_underlined":false,"isFollowingLogosGrid":false},{"css":"","_uid":"a16ad354-f165-4dbe-922c-cf3b7c4557a6","copy":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"While TMS and WMS run on modern data infrastructure, the yard has remained a blind spot—fragmented, manual, and inefficient. Terminal changes that. Our computer vision is not an add-on, it’s the intelligence at the heart of the Terminal Yard Operating System","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#C2C2C2"}}]},{"text":"TM","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#C2C2C2"}},{"type":"superscript"}]},{"text":" (YOS).  We don’t just see; we understand, automate, and orchestrate every move, reinventing how yards flow.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#C2C2C2"}}]}]}]},"wide":true,"label":"The Problem","title":{"type":"doc","content":[{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"The Supply Chain Has Digitized. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"The Yard Hasn’t.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},"buttons":[],"component":"SectionIntroduction","top_notch":true,"bottom_notch":false,"isFullscreen":true,"content_blocks":[],"subscribe_form":false,"background_type":"canvas_grid_pulse","multipleColumns":false,"background_image":{"id":110929944265030,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/1920x1080/7796213307/black-hole.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"background_theme":"dark","buttons_underlined":false,"isFollowingLogosGrid":false},{"_uid":"a42a63ef-2da0-4c6d-b734-b18bd8614809","items":[{"_uid":"67271c61-d561-473c-ba28-8bc97b5f99e5","image":{"id":110990147564399,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/1024x1024/8f8c2641f9/mesh-3.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"heading":"Flexible Technology","component":"GridSection","description":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"This flexible technology works with both fixed and mobile cameras, easily scaling to any facility footprint, from small yards to complex multi-site networks.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]}},{"_uid":"d5620e68-fef3-4dae-9b25-0345d9d8ee89","image":{"id":110989991490391,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/1024x1024/e4d8668473/mesh-2.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"heading":"Plug & Play","component":"GridSection","description":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The system is plug & play, offering seamless integration with your existing WMS/TMS via modern APIs.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]}},{"_uid":"ffa6ba1c-aede-4719-97bf-c7803acea673","image":{"id":110990147564399,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/1024x1024/8f8c2641f9/mesh-3.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"heading":"Enterprise Ready","component":"GridSection","description":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"With a modular architecture, it scales effortlessly across live and drop environments, allowing you to achieve vendor consolidation by replacing multiple point systems with a single, powerful platform.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]}}],"label":"The Solution","theme":"white","title":{"type":"doc","content":[{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"Purpose-Built. Enterprise-Ready.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]},{"type":"hard_break","marks":[{"type":"textStyle","attrs":{"color":""}}]},{"text":"Always Learning. Powered By AI.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},"button":[],"variant":"variant-1","component":"SectionsGrid","paragraph":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"Terminal offers a purpose-built, enterprise-ready, and always-learning solution that goes far beyond traditional OCR or basic license plate readers. The result is an AI-powered, real-time visibility layer across every truck, trailer, chassis, and container — all without the cost and headaches of legacy system.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#454742"}}]}]}]},"top_notch":false,"bottom_notch":false,"background_type":"green_top_animation","bottom_gradient":false,"paragraph_layout":"stacked","show_bottom_extensions":false},{"_uid":"03d1cb42-bbc1-4105-9ad5-cb1de332e795","component":"CaseStudyReference","case_study":[{"name":"Gartner Vision Forecast","created_at":"2025-12-16T16:04:30.030Z","published_at":"2026-06-29T14:50:20.648Z","updated_at":"2026-06-29T14:50:20.661Z","id":123746181272031,"uuid":"5bfa5b91-799c-4977-a9c2-305e312efae9","content":{"_uid":"fc9798ac-75d8-4e7e-b797-0ce73de61a74","logo":{"id":123764089076610,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/620x142/9d1347336e/gartner-logo-white.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"label":"Market Research","media":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"stats":[{"_uid":"05ec1aab-f952-481e-8a6a-2ff994dec137","label":"yard deployments will employ vision-AI enabled autonomous data collection instead of RFID","value":"40%","component":"CaseStudyStat"},{"_uid":"f0899509-992e-42c2-815f-f21077271a46","label":"of WMS systems are supporting some AI enabled vision deployments","value":"50%","component":"CaseStudyStat"}],"theme":"dark","title":"","button":[{"_uid":"bd1440d3-28d3-4f9b-97e5-b6022eba302d","link":{"id":"","url":"https://www.gartner.com/en/documents/6521702","linktype":"url","fieldtype":"multilink","cached_url":"https://www.gartner.com/en/documents/6521702"},"label":"Read More","component":"Button"}],"content":{"type":"doc","content":[{"type":"heading","attrs":{"level":3,"textAlign":null},"content":[{"text":"\"Warehouse and yard operations are beginning to use AI-enabled vision systems to automate activities and visually monitor processes to identify ergonomic, safety and procedural issues to improve performance.\"","type":"text"},{"type":"hard_break"}]}]},"reverse":false,"component":"CaseStudy","media_fit":"float","media_aspect":"auto","testimonial_text":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null}},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"By 2027, 40% of yard and warehouse management deployments will employ vision-AI enabled autonomous data collection instead of RFID.","type":"text","marks":[{"type":"italic"}]}]}]}},"slug":"gartner-vision-forecast","full_slug":"global/case-studies/gartner-vision-forecast","sort_by_date":null,"position":-50,"tag_list":[],"is_startpage":false,"parent_id":123707045129673,"meta_data":null,"group_id":"3100b43a-18a6-406d-966c-0e420d2ca47c","first_published_at":"2025-12-22T19:56:25.172Z","release_id":null,"lang":"default","path":null,"alternates":[],"default_full_slug":null,"translated_slugs":null,"_stopResolving":true}]},{"css":"","_uid":"c8a4b5a0-348f-4ba5-9cc9-1cf7350d20d6","copy":{"type":"doc","content":[{"type":"paragraph"}]},"wide":false,"label":"","title":{"type":"doc","content":[{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"Real-World Workflows, Reinvented with Terminal Computer Vision","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},"buttons":[],"component":"SectionIntroduction","top_notch":false,"bottom_notch":false,"isFullscreen":false,"content_blocks":[],"subscribe_form":false,"background_type":"canvas_grid_waves","multipleColumns":false,"background_image":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"background_theme":"","buttons_underlined":false,"isFollowingLogosGrid":false},{"_uid":"9a019ea4-16e4-458b-bd3f-28a972cb1e73","items":[{"_uid":"37288a79-2982-43ff-a5bc-0581b60a72c1","image":{"id":120978580976576,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/768x432/ce73b10067/gate-entry.jpg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"label":"","title":"Automated Gate Check-In & Check-Out","button":[],"content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Leave behind those manual logs, kiosks, transcription errors, and long queues. With Terminal, AI computer vision auto-captures plates, IDs, and containers in seconds, drivers self-check via mobile, and gates auto-trigger.","type":"text"}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The results: up to 85% faster gate processing and 75% fewer errors.","type":"text"}]}]},"component":"FeaturesGridItemAdvanced"},{"_uid":"20bbcc00-adb4-43e5-8eec-381fc3f2bbf7","image":{"id":120918136052926,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/6016x3200/1d7e2ff682/logistics-port2.jpg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"label":"","title":"Asset Inventory & Location Management","button":[],"content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Never suffer again with manual checks, RFID failures, and stale spreadsheets. Terminal AI CV-powered RTLS continuously maps every asset’s location, dwell time, and status.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#454742"}}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The results: 90% less time wasted searching; 25% better asset utilization.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#454742"}}]}]}]},"component":"FeaturesGridItemAdvanced"},{"_uid":"9b1420b7-410d-4093-953c-630b96ca09d2","image":{"id":92500286680893,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/936x730/0cf1e3d9f3/k.webp","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"label":"","title":"Automated Damage Detection","button":[],"content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Put those inconsistent manual inspections, disputes, and costly claims behind you.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#454742"}}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"With Terminal, you can inspect cargo at arrival/departure, and automated comparisons highlight new damage with time-stamped evidence. The results: fewer disputes, stronger carrier relationships, enhanced brand protection.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#454742"}}]}]}]},"component":"FeaturesGridItemAdvanced"},{"_uid":"5ab809bf-957c-47dc-9534-3a19cd8fc2fa","image":{"id":121011901925280,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/337048/924x484/fdfaa40daf/yard-storage-security.jpg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"label":"","title":"Security & Fraud Detection","button":[],"content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal’s vision AI continuously monitors for unauthorized access, asset theft, and fraudulent activity—automating what guards and cameras alone can’t catch.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#454742"}}]}]}]},"component":"FeaturesGridItemAdvanced"}],"button":[],"component":"FeaturesGrid"},{"_uid":"af81bdc4-54ef-4904-afa5-6866fb329014","text":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":"left"},"content":[{"text":"Terminal isn’t a bolt-on solution. It’s an AI-native operating system for the modern yard, a platform where computer vision drives efficiency, resilience, and intelligence at scale.","type":"text","marks":[{"type":"bold"}]}]}]},"subtitle":{"type":"doc","content":[{"type":"paragraph"}]},"component":"InfoSection"},{"_uid":"52daa67c-fb5b-492e-9c70-58bd62a0ff5c","posts":["8158c4aa-2998-4ba4-a3f5-998987c00907","5ad58276-8f1c-4f3a-88bf-32686e5f614e","706a88be-86ec-485b-96e8-acd2891bd7d2","b7969bbf-b012-4163-8c69-a740323620fb","946e29ca-6a89-4fbe-8ccb-34a4c0f8cfdc","60c58757-37f9-44ca-a272-769697b9dba6"],"title":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null}}]},"component":"FeaturedBlogPosts","intro_text":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null}}]},"content_headline":"Terminal Computer Vision in Action"},{"_uid":"0301b78e-9121-4d9b-84f4-85297849a294","tabs":[{"_uid":"878b66b1-6420-40da-837e-b2e224002959","items":[{"_uid":"f4dc4a1c-8cd7-42fa-86a0-8fc4e6b17f38","title":"Resistance to operational change","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yards traditionally rely on manual processes and are resistant to change. This ingrained culture makes it difficult to introduce new technology. Terminal's approach provides a strong ROI case to business leaders, making the financial benefits of change compelling, while its simple, turnkey deployment and managed infrastructure reduce the friction of adoption.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"8b0baaf3-096d-4fce-a662-99fbe6d96811","title":"Worker resistance to automation","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Workers worry about losing their jobs to new technology. This fear can lead to resistance from frontline staff and create a negative environment for adoption. Terminal uses a human-in-the-loop onboarding process that redefines roles, allowing staff to be redeployed to higher-value tasks, and provides ongoing support, which alleviates job security fears.","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"05da1943-0fc8-4913-9896-53a0c338efd8","title":"Skepticism from failed pilots","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Customers are wary of new solutions due to past failures with other vendors. This long memory of past disappointments makes them cautious about investing again. Terminal builds trust with referenceable customers and proven performance, demonstrating a faster time-to-value (5 days vs. competitors' 5+ months) and lower deployment costs through rapid, successful results.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"48c2d578-217c-4691-b7ae-cbb28ab5ffa5","title":"Fear of workflow disruption","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Operators are afraid that new technology will break their existing, established, and profitable processes. This fear of risk outweighs the upside benefits for many companies. Terminal’s simple, turnkey deployment model and modular, on/off capability minimize this risk, allowing customers to start small and integrate the solution without a complete overhaul of their operations.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"9e0764a8-67a0-4233-ad5c-6b4c0efc8fec","title":"Cybersecurity and privacy risks","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"New interconnected yard systems introduce new vulnerabilities and data management risks. Companies with legacy systems or fragmented operations are especially vulnerable to these threats. As a fully managed solution with a unified, cloud-based platform, Terminal provides a secure, single-source system that is inherently more secure than managing a fragmented collection of different legacy tools.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Change Mgmt","component":"TabbedAccordionTab"},{"_uid":"783c9eee-7850-4a11-8641-f66e61b7e0cd","items":[{"_uid":"cf26ce72-18b1-4626-ad38-0408f71a162d","title":"Complex system integration challenges","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"New technology often doesn't fit with a customer's legacy software ecosystem. This creates a risk of operational disruption and requires significant resources to build custom integrations. Terminal's modular, API-based platform is designed for seamless integration, easily connecting with existing business systems both upstream and downstream.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"9fef7fe6-dca1-4f01-989d-2d2557c945f8","title":"Lack of on-site IT infrastructure","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yards often lack reliable power, lighting, or internet access. This poor infrastructure makes it difficult to deploy and operate new technology. Terminal's solution includes a fully managed infrastructure that can bundle power, network, lighting, and cameras into a single, affordable annual fee.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"a830fd73-562b-47c4-9094-0f65e7d60924","title":"Limited technical staff","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Operators that do not have the in-house expertise to set up and maintain complex technology struggle to manage deployments and troubleshoot issues. Terminal provides a turnkey deployment and training model with robust delivery and support processes, ensuring a smooth and hands-off implementation.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"116ab842-f23a-411d-aa98-dd36bc98ab13","title":"Fragmented yard technology market","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The market is crowded with old technology and no unified solutions. This forces customers to evaluate numerous point solutions that don't integrate well. Terminal builds an all-in-one solution that avoids the need for multiple, inadequate products that are costly and fail to deliver real ROI.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"08e4a878-6d44-4874-b9d2-f81d8d78be6b","title":"Fragmented technology across yards","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Different yards often use different, inconsistent tools. This lack of standardization leads to poor data quality and makes it difficult to manage a portfolio of yards. Terminal provides a unified, AI-driven \"","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]},{"text":"OS for the Yard","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}},{"type":"bold"}]},{"text":"\" that integrates with legacy systems and TMS/WMS, ensuring consistency across a customer's entire operation.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"0431c804-8ebd-4108-ba08-38c4d97df3be","title":"Unreliable legacy tagging technology ","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Physical tags and signals like RFID, GPS, and IoT often fail in real-world yard environments. These technologies can have accuracy issues, signal interference, or require complex maintenance. Terminal’s computer vision accurately identifies assets visually without relying on physical tags or signals, making it more scalable, less invasive, and proven accurate in deployments and a more feasible solution for yard with different load carriers.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"ed7638f4-f68c-40bb-8ec3-2b544af99786","title":"Desire to find the perfect solution","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Operators often get bogged down by the desire for a perfect, customized solution from the start. This pursuit of a comprehensive system leads to an endless scope of work and project failure before anything can be implemented. Terminal's turnkey and simple deployment model, which delivers value in as little as 5 days, is built to counteract this, providing tangible results and a clear path to expansion without getting lost in endless customization.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Tech Stack","component":"TabbedAccordionTab"},{"_uid":"7dc17bb2-f9db-491a-9642-bfa2d753fad7","items":[{"_uid":"f5879a14-c358-4b25-853d-39a45c305ed2","title":"High cost and ROI uncertainty","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Technology is often seen as too expensive with an unclear return on investment. Customers worry that the high installation costs and thin margins of yard operations won't justify the expense. Terminal offers affordable, turnkey, and simple bundled pricing with an all-in-one investment option and modular capabilities that allow customers to scale their investment and see a clear, fast return.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"4dadd94e-2786-4f41-a89d-820429bd25f8","title":"Costly regulatory compliance burdens","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Meeting local regulatory requirements, such as ISR in Southern California, is a time-consuming and expensive process. Manual compliance is also prone to error and can lead to costly fines. Terminal’s ISR Compliance solution provides full automation via computer vision, which drastically reduces the risk of fines and simplifies the entire compliance process.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"e3860cc3-aadd-40fa-8425-700f37d36bd2","title":"Flawed ROI metrics and focus","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Customers have a narrow view of ROI, often focusing only on how many people they can displace. This approach ignores other significant costs, such as driver detention and wasted capacity. Terminal's strong ROI case highlights value beyond labor, including faster time-to-value, reductions in driver detention fees, and increased asset utilization, which are more compelling to executive-level buyers.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Costs / ROI","component":"TabbedAccordionTab"},{"_uid":"c1cf55cd-f946-4e3a-ba5c-e938b84f1d40","items":[{"_uid":"22b39ec8-5643-4aa3-8a31-ecbf5f8023fa","title":"Inefficient manual gate processes","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Manual, error-prone gate check-in/out processes cause delays and inefficiency. These issues result in increased driver wait times and administrative errors. Terminal enables Gate Acceleration with computer vision (CV) and tablet automation, reducing truck dwell time from 5-10 minutes to less than 5 minutes.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"8b7eecec-ede5-4473-888a-2c8d9bebbbf2","title":"The yard black hole","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The yard is often seen as an unstructured and chaotic \"black hole\" within the supply chain. This perception causes the area to be overlooked in digital transformation efforts, even as other parts of the supply chain become more digitized. Terminal's unified platform directly addresses this problem by bringing a high degree of structure, automation, and real-time visibility to the yard, making it a visible and manageable part of the supply chain for the first time.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"eb10c825-e65b-467a-905f-7386d49a7b2f","title":"Absence of unified industry standards","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"There is a lack of standardized protocols and data formats for yard technology. This makes it challenging to integrate solutions with different systems and partners. Terminal's API-driven \"OS for the Yard\" acts as a unifying layer, built to integrate seamlessly with various legacy systems and partner platforms, effectively creating a single standard for the customer.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"c16c2bea-969d-424a-a42f-8c06ac1ee997","title":"Poor data quality and capture","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Data is often messy, unreliable, or captured inconsistently across yard operations. This makes it difficult to make data-driven decisions and identify opportunities for improvement. Terminal's ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]},{"text":"CV and AI technology","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}},{"type":"bold"}]},{"text":" create a unified platform and data lake, as computer vision is the most efficient and accurate method for yard data capture, accommodating unstructured data and providing high-quality information.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"0a13e77a-b18d-4883-bbc4-aad089e595ba","title":"Lack of real-time visibility","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Finding trailers and conducting manual asset inventory is time-consuming and inefficient. This lack of visibility leads to wasted labor hours and lost capacity. Terminal's Cloud Capture & Asset Inventory Solution, powered by computer vision and a cloud ML pipeline, indexes asset data in real-time and automates inventory validation in just 20–30 minutes per day versus the traditional 4–6 hours.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1B1C1D"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Poor Ops","component":"TabbedAccordionTab"}],"content":{"type":"doc","content":[{"type":"heading","attrs":{"level":2,"textAlign":null},"content":[{"text":"The Most Common","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}},{"type":"bold"}]},{"text":" Technology Hurdles in the Yard","type":"text","marks":[{"type":"textStyle","attrs":{"color":""}}]}]},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Here are the most common hurdles to technology adoption in the yard. Choose the one that is holding you back to see how Terminal can help.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#454742"}}]}]}]},"component":"TabbedAccordion"},{"_uid":"4ebc7e0d-2d6c-4b2c-b30c-2d1f1a297fb2","form":[{"name":"Contact Us Interior Pages","created_at":"2025-11-29T12:23:43.758Z","published_at":"2026-07-14T16:45:50.195Z","updated_at":"2026-07-14T16:45:50.208Z","id":117675719741847,"uuid":"dac48279-df53-4d3e-8245-d3c5edee217c","content":{"_uid":"e404e9db-959f-4811-9e68-310f3c264c49","info":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Fill out the form, and we’ll be happy to discuss how Terminal can help you with your yard of the future:","type":"text","marks":[{"type":"textStyle","attrs":{"color":""