2-4ebd-8062-9e2117040e8f","6c52152d-bc76-4a6c-9c4c-ed2ef39df895","e7a31d8e-47e8-4598-aea1-b507a313d86e","94d55377-e7fe-4bf6-9fc3-ffa8536463b7","aa006f36-8f12-493c-90ec-4294592d076c","5cf08e72-f671-450d-972d-88ca323846f8","2781a62c-9964-42bb-ab31-635256152390","cd5ec51d-9e26-4a05-8f85-55f0c0d5146f","f7921fd6-3eef-4dc8-bee9-81d11ee7e607"]},{"_uid":"d1d003bd-db01-4d22-9c1b-da508f68deb3","tabs":[{"_uid":"7eeb2631-a584-43b5-a7fe-1f801476952d","items":[{"_uid":"67c4c4ec-669a-46e9-b090-e1e4c2cfba73","title":"What does Terminal actually do?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is an AI-native Yard Operating System","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]},{"text":"TM","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}},{"type":"superscript"}]},{"text":" (YOS","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]},{"text":"TM","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}},{"type":"superscript"}]},{"text":") that uses computer vision to automate yard execution from gate to dock. It replaces manual logs with a system that proactively decides and executes the next best move in real-time.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"a9365770-e975-4ce2-b104-8d0217853953","title":"How is this different from a traditional Yard Management System (YMS)?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Traditional YMS are \"digital clipboards\" that record what already happened; Terminal is an ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]},{"text":"operating","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}},{"type":"italic"}]},{"text":" system that sees what is happening now and orchestrates what needs to happen next in the yard. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"6057177b-869b-4ddd-a6a5-f6f9e1667d56","title":"What is \"Agentic AI\" in the context of the yard?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"It acts as a 24/7 autonomous supervisor that handles exceptions and reprioritizes tasks based on real-time conditions, ensuring the most critical moves happen first (e.g. how to prepare and reallocate resources for a late appointment)","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"13d194f8-3ac3-415e-8231-389b0824c9fc","title":"How accurate is the data captured by your system?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Our proprietary computer vision stack delivers 50%or more improvement in data accuracy vs. manual operations, virtually eliminating the human error and \"lost assets\" common with manual entry.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"3b9220e6-02d1-4f72-bc81-356f80bdc4a3","title":"Can we manage multiple sites from a single login?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yes; Terminal provides a \"Global Control Tower\" view, allowing you to compare KPIs, dwell times, and performance across all facilities in your network in one place.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Core Technology","component":"TabbedAccordionTab"},{"_uid":"ed98d17c-3e6c-4494-91b6-08b47b1e8af8","items":[{"_uid":"b07e6958-dca2-474b-a95f-d6a93b5f7e2b","title":"How is Terminal priced?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is priced as a competitive annual, all-inclusive as-a-service model for all hardware, support, and services. Deployments can vary and are charged as a separate up-front fee.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"220afd0f-7d8f-433c-a008-7dbf57a1bbd1","title":"What kind of ROI can I expect?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Most customers see a 4x+ ROI within the first year and achieve a full payback in less than 5 months through labor savings and faster throughput.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"d1dc8ead-7f4c-4b55-b674-c7bf1d5d30a1","title":"How does Terminal reduce carrier and facility costs?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"We reduce driver detention fees by improving gate processing times, faster responsiveness at the dock, and maximum visibility to all asset inventory in the yard. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"1f81a979-6291-4697-b775-082984e71b1c","title":"Can Terminal help with regulatory compliance?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yes; our Indirect Source Rule (ISR) feature automates compliance by generating audit-ready data for regulations like Rule 2305.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"8af4e52d-6959-44f1-ac5d-330c56c84414","title":"Who is Terminal best suited for?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is built for enterprise 3PLs, retailers, and manufacturers managing complex, medium- to high-volume mutli-yard networks that want to scale without adding headcount.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"82762bbd-c9cb-41d8-9e18-9d1ad13a998a","title":"Is Terminal a stable long-term partner? ","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Founded in 2023 and backed by 8VC and four of the top 10 U.S. logistics firms (including Prologis and Ryder), Terminal offers deep financial and strategic stability.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Value","component":"TabbedAccordionTab"},{"_uid":"fe108c93-b615-46ad-8004-0a0e774a6298","items":[{"_uid":"2e4b4e5d-a4f9-4904-b472-00d357ffe812","title":"How fast can we go live?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Gate automation can be live in as little as 5 days, with full yard orchestration typically completed in 45 days.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"60d4de18-7cf6-4c49-9059-413071d39a51","title":"Does Terminal integrate with my existing WMS/TMS?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Yes; we offer seamless, event-driven integration with major platforms like Manhattan, SAP, Blue Yonder, FourKites, and project44.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"c5702309-fea8-42e2-bf85-ee50f6e40f12","title":"Do I need to buy expensive proprietary cameras?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"No; Terminal is hardware-agnostic and can often leverage your existing IP cameras, or you can use our plug-and-play \"Terminal in a Camera\" bundles.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"5a37ebce-5484-4c61-a032-a83d88acfb9e","title":"Is the platform modular or \"all-or-nothing\"?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"The system is highly configurable; you can start with a single use case, like Gate Acceleration, and expand into full yard orchestration over time.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"9bddd67f-1af3-464f-849e-87922d0941dd","title":"What happens if our site’s internet goes down?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is designed with local resilience; mission-critical tasks continue to buffer locally and sync to the cloud once connectivity is restored.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"445bf071-f02c-4210-85b2-5bbe5664357e","title":"How does Terminal protect my data?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"We use a zero-trust security model with industry-standard encryption and are currently in the process of achieving SOC-2 compliance.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Implementation","component":"TabbedAccordionTab"},{"_uid":"ab585679-9d7b-49e0-a29f-9d46180c65ca","items":[{"_uid":"1dd20b08-4a33-4c1a-ab86-c8db2c612461","title":"How do drivers and yard spotters interact with the system?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Terminal is browser- based (not app to download!). Drivers can use their personal mobile devices, while spotters and dock workers can be outfitted with any browser-enabled mobile device approved by the operator. ","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"71ed6e73-abc2-4b61-a9f8-ba7240b821bf","title":"How does this change the role of my yard office staff?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"Staff shift from manual data entry to \"exception management,\" only intervening when the AI flags a specific issue that requires human judgment.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"729dea71-3358-47ab-908c-55826a84d904","title":"Will implementation disrupt my current operations?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"No; our deployment model requires little operational downtime and carries a very low IT lift for your team.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"1dffc59c-2bfd-4e86-932d-7a5707d78359","title":"What kind of support and training do you provide?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"We provide \"White-Glove\" on-site training for all shifts, 24/7 live technical support, and a dedicated hypercare period post-launch.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"},{"_uid":"5601cefa-5b18-475e-b7da-7ed4e655dbda","title":"What is your system availability guarantee?","content":{"type":"doc","content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"text":"As long as yard internet is running, Terminal runs at a 99.9% uptime for all mission-critical workflows to ensure your yard operations never stop.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#1F1F1F"}}]}]}]},"component":"TabbedAccordionItem"}],"label":"Site Operations","component":"TabbedAccordionTab"}],"content":{"