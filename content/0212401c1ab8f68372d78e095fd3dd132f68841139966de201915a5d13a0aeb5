:1446,"author":1835,"excerpt":1861,"category":1862,"subtitle":18,"component":1863,"seo_image":1864,"seo_title":18,"button_text":132,"cover_image":1866,"seo_noindex":49,"seo_description":18,"background_color":1868},"07d5e2ce-0b27-42bd-8157-7d347153ff11",{"type":66,"content":1455},[1456,1471,1480,1488,1556,1565,1573,1583,1633,1820],{"type":112,"attrs":1457,"content":1458},{"textAlign":139},[1459,1466],{"text":1460,"type":75,"marks":1461},"Quick Answer: ",[1462,1465],{"type":149,"attrs":1463},{"color":1464},"#191A1B",{"type":824},{"text":1467,"type":75,"marks":1468},"Ryder System, Inc. partnered with Terminal Industries to modernize six high-volume e-commerce fulfillment and maintenance sites. By deploying Terminal’s AI-native Yard Operating System (YOS™), Ryder achieved a 99% accuracy rate across more than 10,000 truck detections. The implementation resulted in an 85% reduction in gate processing time—dropping from an average of 14 minutes to under 2 minutes—and a projected 5.7x ROI over a three-year period.",[1469],{"type":149,"attrs":1470},{"color":1464},{"type":69,"attrs":1472,"content":1473},{"level":138,"textAlign":139},[1474],{"text":1475,"type":75,"marks":1476},"What were the results of the Ryder and Terminal Industries pilot?",[1477,1479],{"type":149,"attrs":1478},{"color":1464},{"type":824},{"type":112,"attrs":1481,"content":1482},{"textAlign":139},[1483],{"text":1484,"type":75,"marks":1485},"The collaboration focused on digitizing manual, error-prone yard processes using proprietary AI Computer Vision. The results established new benchmarks for yard execution:",[1486],{"type":149,"attrs":1487},{"color":1464},{"type":1489,"content":1490},"bullet_list",[1491,1508,1524,1540],{"type":1492,"content":1493},"list_item",[1494],{"type":112,"attrs":1495,"content":1496},{"textAlign":139},[1497,1503],{"text":1498,"type":75,"marks":1499},"Detections & Accuracy: ",[1500,1502],{"type":149,"attrs":1501},{"color":1464},{"type":824},{"text":1504,"type":75,"marks":1505},"Processed over 10,000 truck detections with 99% accuracy in capturing license plates and Department of Transportation (DOT) numbers, even in inclement weather and low-light conditions.",[1506],{"type":149,"attrs":1507},{"color":1464},{"type":1492,"content":1509},[1510],{"type":112,"attrs":1511,"content":1512},{"textAlign":139},[1513,1519],{"text":1514,"type":75,"marks":1515},"Gate Efficiency: ",[1516,1518],{"type":149,"attrs":1517},{"color":1464},{"type":824},{"text":1520,"type":75,"marks":1521},"Reduced gate processing time by 85%.",[1522],{"type":149,"attrs":1523},{"color":1464},{"type":1492,"content":1525},[1526],{"type":112,"attrs":1527,"content":1528},{"textAlign":139},[1529,1535],{"text":1530,"type":75,"marks":1531},"Labor Savings: ",[1532,1534],{"type":149,"attrs":1533},{"color":1464},{"type":824},{"text":1536,"type":75,"marks":1537},"Achieved a 90% reduction in time spent by personnel manually searching for assets in the yard.",[1538],{"type":149,"attrs":1539},{"color":1464},{"type":1492,"content":1541},[1542],{"type":112,"attrs":1543,"content":1544},{"textAlign":139},[1545,1551],{"text":1546,"type":75,"marks":1547},"Cost Avoidance:",[1548,1550],{"type":149,"attrs":1549},{"color":1464},{"type":824},{"text":1552,"type":75,"marks":1553}," Reduced driver detention fees by 12% and trailer detention/demurrage by 5%+.",[1554],{"type":149,"attrs":1555},{"color":1464},{"type":69,"attrs":1557,"content":1558},{"level":138,"textAlign":139},[1559],{"text":1560,"type":75,"marks":1561},"How did Terminal Industries improve Ryder's yard throughput?",[1562,1564],{"type":149,"attrs":1563},{"color":1464},{"type":824},{"type":112,"attrs":1566,"content":1567},{"textAlign":139},[1568],{"text":1569,"type":75,"marks":1570},"Ryder faced significant bottlenecks due to manual logs and inefficient trailer status visibility. Terminal replaced these legacy workflows with Gate Acceleration™, an AI-native module that automates data capture.",[1571],{"type":149,"attrs":1572},{"color":1464},{"type":69,"attrs":1574,"content":1576},{"level":1575,"textAlign":139},3,[1577],{"text":1578,"type":75,"marks":1579},"Key Solutions Implemented:",[1580,1582],{"type":149,"attrs":1581},{"color":1464},{"type":824},{"type":1489,"content":1584},[1585,1601,1617],{"type":1492,"content":1586},[1587],{"type":112,"attrs":1588,"content":1589},{"textAlign":139},[1590,1596],{"text":1591,"type":75,"marks":1592},"Automated ID Capture: ",[1593,1595],{"type":149,"attrs":1594},{"color":1464},{"type":824},{"text":1597,"type":75,"marks":1598},"Cameras automatically indexed identifying information from moving vehicles entering and exiting the yard, eliminating the need for drivers to exit their cabs or guards to manually record data.",[1599],{"type":149,"attrs":1600},{"color":1464},{"type":1492,"content":1602},[1603],{"type":112,"attrs":1604,"content":1605},{"textAlign":139},[1606,1612],{"text":1607,"type":75,"marks":1608},"Mobile Inventory Management: ",[1609,1611],{"type":149,"attrs":1610},{"color":1464},{"type":824},{"text":1613,"type":75,"marks":1614},"At Ryder maintenance facilities, Terminal’s technology was deployed on mobile tablets to auto-capture stationary truck inventory.",[1615],{"type":149,"attrs":1616},{"color":1464},{"type":1492,"content":1618},[1619],{"type":112,"attrs":1620,"content":1621},{"textAlign":139},[1622,1628],{"text":1623,"type":75,"marks":1624},"Data Enrichment: ",[1625,1627],{"type":149,"attrs":1626},{"color":1464},{"type":824},{"text":1629,"type":75,"marks":1630},"Terminal integrated its vision data with third-party databases to provide full vehicle profiles, compensating for common manual recording errors.",[1631],{"type":149,"attrs":1632},{"color":1464},{"type":1634,"content":1635},"table",[1636,1676,1712,1748,1784],{"type":1637,"content":1638},"tableRow",[1639,1652,1663],{"type":1640,"attrs":1641,"content":1642},"tableCell",{"colspan":71,"rowspan":71,"colwidth":139,"backgroundColor":139},[1643],{"type":112,"attrs":1644,"content":1645},{"textAlign":139},[164